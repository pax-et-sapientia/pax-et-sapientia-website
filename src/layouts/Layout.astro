---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';
import '@fontsource/inter';
import '@fontsource/playfair-display';
import '../styles/global.css';

interface Props {
	title: string;
  description?: string;
}

const { title, description = "Sito ufficiale della Fondazione Benedettina Pax et Sapientia - ETS. Promozione della cultura, tutela dell'ambiente e formazione." } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang} class="overflow-x-hidden max-w-full m-0 p-0">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={description} />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Fondazione Pax et Sapientia</title>
	</head>
	<body class="font-sans text-[#1A2B4C] bg-gray-50 flex flex-col min-h-screen w-full overflow-x-hidden m-0 p-0 relative">
		<Header />
		<main class="flex-grow w-full overflow-x-hidden">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
  :root {
    --primary: #1A2B4C;
    --secondary: #708090;
    --accent: #C5A059;
  }
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
    min-width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    position: relative;
    -webkit-text-size-adjust: 100%;
    box-sizing: border-box;
	}
  *, *::before, *::after {
    box-sizing: border-box;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Playfair Display', serif;
  }
</style>
