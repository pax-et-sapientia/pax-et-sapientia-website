---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Cookie Policy">
  <div class="bg-gray-50 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-[#1A2B4C] mb-8">Cookie Policy</h1>
      
      <div class="prose prose-lg text-gray-700 max-w-none">
        <p>
          This site exclusively uses technical cookies necessary for correct functioning and navigation. 
          Profiling or third-party cookies for advertising purposes are not used.
        </p>

        <h2 class="text-2xl font-bold text-[#1A2B4C] mt-12 mb-4">Third-Party Services</h2>
        <p>
          The site incorporates a contact form via Google Forms. Google may use cookies to ensure 
          the security and operation of the service. We invite you to consult Google's privacy policy for more details.
        </p>
      </div>
    </div>
  </div>
</Layout>
