---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50 w-full">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex justify-between h-24 items-center w-full">
      <!-- Logo and Site Name -->
      <div class="flex items-center">
        <a href={lang === 'it' ? '/' : `/${lang}/`} class="flex items-center">
          <picture>
            <source srcset="/logo.webp" type="image/webp" />
            <img 
              src="/logo.png" 
              alt="Pax et Sapientia Logo" 
              class="h-16 w-16 object-contain"
              width="64"
              height="64"
              loading="eager"
            />
          </picture>
          <span class="ml-3 text-xl font-serif font-bold text-[#1A2B4C] hidden sm:block">
            PAX ET SAPIENTIA
          </span>
        </a>
      </div>
      
      <!-- Desktop Navigation (Visible from Large Screens / 1024px+) -->
      <nav class="hidden lg:flex space-x-8">
        <a href={lang === 'it' ? '/' : `/${lang}/`} class="text-[#1A2B4C] hover:text-[#C5A059] font-medium transition-colors">
          {t('nav.home')}
        </a>
        <a href={lang === 'it' ? '/chi-siamo' : `/${lang}/about`} class="text-[#1A2B4C] hover:text-[#C5A059] font-medium transition-colors">
          {t('nav.about')}
        </a>
        <a href={lang === 'it' ? '/sostienici' : `/${lang}/support`} class="text-[#1A2B4C] hover:text-[#C5A059] font-medium transition-colors">
          {t('nav.support')}
        </a>
        <a href={lang === 'it' ? '/trasparenza' : `/${lang}/transparency`} class="text-[#1A2B4C] hover:text-[#C5A059] font-medium transition-colors">
          {t('nav.transparency')}
        </a>
        <a href={lang === 'it' ? '/contatti' : `/${lang}/contact`} class="text-[#1A2B4C] hover:text-[#C5A059] font-medium transition-colors">
          {t('nav.contact')}
        </a>
      </nav>

      <!-- Language Switcher and Mobile Menu Button -->
      <div class="flex items-center space-x-4">
        <!-- Language Switcher (Desktop and Tablet) -->
        <div class="hidden sm:flex space-x-2">
          {Object.entries(languages).map(([code, label]) => (
            <a
              href={code === 'it' ? '/' : `/${code}/`}
              class={`px-2 py-1 text-sm rounded ${lang === code ? 'bg-[#1A2B4C] text-white' : 'text-[#1A2B4C] hover:bg-gray-100'}`}
            >
              {code.toUpperCase()}
            </a>
          ))}
        </div>

        <!-- Mobile Menu Button (Hamburger) - Visible up to 1023px -->
        <button 
          id="mobile-menu-button"
          type="button" 
          class="lg:hidden p-2 rounded-md text-[#1A2B4C] hover:bg-gray-100 focus:outline-none"
          aria-label="Menu"
        >
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu - Visible up to 1023px -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-gray-200">
    <div class="px-4 pt-2 pb-6 space-y-1">
      <a href={lang === 'it' ? '/' : `/${lang}/`} class="block px-3 py-4 text-base font-medium text-[#1A2B4C] hover:bg-gray-50 rounded-md">
        {t('nav.home')}
      </a>
      <a href={lang === 'it' ? '/chi-siamo' : `/${lang}/about`} class="block px-3 py-4 text-base font-medium text-[#1A2B4C] hover:bg-gray-50 rounded-md">
        {t('nav.about')}
      </a>
      <a href={lang === 'it' ? '/sostienici' : `/${lang}/support`} class="block px-3 py-4 text-base font-medium text-[#1A2B4C] hover:bg-gray-50 rounded-md">
        {t('nav.support')}
      </a>
      <a href={lang === 'it' ? '/trasparenza' : `/${lang}/transparency`} class="block px-3 py-4 text-base font-medium text-[#1A2B4C] hover:bg-gray-50 rounded-md">
        {t('nav.transparency')}
      </a>
      <a href={lang === 'it' ? '/contatti' : `/${lang}/contact`} class="block px-3 py-4 text-base font-medium text-[#1A2B4C] hover:bg-gray-50 rounded-md">
        {t('nav.contact')}
      </a>
      
      <!-- Mobile Language Switcher -->
      <div class="pt-4 border-t border-gray-100 flex space-x-4 px-3">
        {Object.entries(languages).map(([code, label]) => (
          <a
            href={code === 'it' ? '/' : `/${code}/`}
            class={`px-4 py-2 text-sm rounded ${lang === code ? 'bg-[#1A2B4C] text-white' : 'text-[#1A2B4C] border border-gray-200'}`}
          >
            {label}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenuButton && mobileMenu && menuIcon && closeIcon) {
    mobileMenuButton.addEventListener('click', () => {
      const isExpanded = mobileMenu.classList.contains('hidden');
      
      if (isExpanded) {
        mobileMenu.classList.remove('hidden');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    });
  }
</script>
